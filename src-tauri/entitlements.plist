<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened-runtime resource access: microphone + system-audio capture,
         and read-only local calendar. Note: NO network entitlements. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- The App Sandbox is deliberately OFF. WKWebView's helper processes
         cannot start inside a sandboxed app that refuses
         com.apple.security.network.client - and refusing it is the point
         (v0.2.0 shipped sandboxed once: white screen, WebContent crash loop).
         Without the App Sandbox, the seatbelt profile in airlock.rs loads at
         launch and denies outbound sockets for the whole process; the
         sandboxed build could not even load it (nested profiles are denied).
         That seatbelt, plus the absence of any network code (see the Airlock
         CI gate), is the enforcement. -->
</dict>
</plist>
